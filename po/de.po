#: src/ui_settings.py
msgid "Measures how fast this computer calculates each algorithm and recommends one."
msgstr "Misst, wie schnell dieser Computer jeden Algorithmus berechnet, und empfiehlt einen."

#: src/ui_dialogs.py
msgid "Only finds accidental errors"
msgstr "Erkennt nur zufällige Fehler"

#: src/ui_dialogs.py
msgid "No longer secure"
msgstr "Nicht mehr sicher"

#: src/ui_dialogs.py
msgid "Secure"
msgstr "Sicher"

#: src/ui_dialogs.py
msgid "How much data this computer can check per second. A longer bar is faster. Your drive is often slower, and then it sets the pace."
msgstr "Wie viele Daten dieser Computer pro Sekunde prüfen kann. Ein längerer Balken ist schneller. Das Laufwerk ist oft langsamer und bestimmt dann das Tempo."

#: src/ui_settings.py
msgid "<b>{name}</b> is the fastest secure algorithm on this computer."
msgstr "<b>{name}</b> ist der schnellste sichere Algorithmus auf diesem Computer."

#: src/ui_dialogs.py
msgid "CRC32 is faster, but it only finds accidental errors, not deliberate changes."
msgstr "CRC32 ist schneller, erkennt aber nur zufällige Fehler, keine absichtlichen Änderungen."

#: src/ui_dialogs.py
msgid "{name} is faster, but it is no longer secure against deliberate changes."
msgstr "{name} ist schneller, bietet aber keinen sicheren Schutz mehr vor absichtlichen Änderungen."

#: src/ui_dialogs.py
msgid "Recommendation"
msgstr "Empfehlung"
