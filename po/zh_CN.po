msgstr "已安装版本:{version}"

#: src/ui_settings.py
msgid "Check now"
msgstr "立即检查"

#: src/ui_settings.py
msgid "Could not check for updates. Are you online?"
msgstr "无法检查更新。您是否在线?"

#: src/ui_settings.py
msgid "TrustCopy is up to date."
msgstr "TrustCopy 已是最新版本。"

#: src/ui_dialogs.py
