msgid "Shut down now"
msgstr "Wyłącz teraz"

#: src/ui_dialogs.py
msgid "Suspend now"
msgstr "Uśpij teraz"

#: src/ui_panel.py
#, python-brace-format
msgid "The computer could not be shut down: {error}"
msgstr "Nie udało się wyłączyć komputera: {error}"

#: src/ui_panel.py
#, python-brace-format
msgid "The computer could not be suspended: {error}"
msgstr "Nie udało się uśpić komputera: {error}"

#: src/ui_settings.py
msgid "What happens when a file with that name is already in the target."
msgstr "Co się dzieje, gdy w miejscu docelowym już istnieje plik o tej nazwie."

#: src/ui_settings.py
msgid "Algorithm"
msgstr "Algorytm"

#: src/ui_settings.py
msgid "SHA-256 is the safe standard, CRC32 the fastest."
msgstr "SHA-256 to bezpieczny standard, CRC32 jest najszybszy."

#: src/ui_dialogs.py
msgid "Programs that are still open are closed. Unsaved work in them can be lost."
msgstr "Programy, które są jeszcze otwarte, zostaną zamknięte. Niezapisana w nich praca może zostać utracona."

#: src/ui_settings.py
msgid "Algorithm speed"
msgstr "Szybkość algorytmów"

#: src/ui_settings.py
msgid "Test"
msgstr "Testuj"

#: src/ui_settings.py
msgid "Testing…"
msgstr "Testowanie…"

#: src/ui_settings.py
msgid "Measures how fast this computer calculates each algorithm and recommends one."
msgstr "Mierzy, jak szybko ten komputer oblicza każdy algorytm, i poleca jeden z nich."

#: src/ui_dialogs.py
msgid "Only finds accidental errors"
msgstr "Wykrywa tylko przypadkowe błędy"

#: src/ui_dialogs.py
msgid "No longer secure"
msgstr "Nie jest już bezpieczny"

#: src/ui_dialogs.py
msgid "Secure"
msgstr "Bezpieczny"

#: src/ui_dialogs.py
msgid "How much data this computer can check per second. A longer bar is faster. Your drive is often slower, and then it sets the pace."
msgstr "Ile danych ten komputer może sprawdzić w ciągu sekundy. Dłuższy pasek oznacza szybszą sumę. Dysk jest często wolniejszy i wtedy to on wyznacza tempo."

#: src/ui_settings.py
msgid "<b>{name}</b> is the fastest secure algorithm on this computer."
msgstr "<b>{name}</b> to najszybszy bezpieczny algorytm na tym komputerze."

#: src/ui_dialogs.py
msgid "CRC32 is faster, but it only finds accidental errors, not deliberate changes."
msgstr "CRC32 jest szybszy, ale wykrywa tylko przypadkowe błędy, a nie celowe zmiany."

#: src/ui_dialogs.py
msgid "{name} is faster, but it is no longer secure against deliberate changes."
msgstr "{name} jest szybszy, ale nie chroni już przed celowymi zmianami."

#: src/ui_dialogs.py
msgid "Recommendation"
msgstr "Zalecenie"

#: src/ui_settings.py
msgid "Check for updates weekly"
msgstr "Sprawdzaj aktualizacje co tydzień"

#: src/ui_settings.py
msgid "Asks GitHub once a week for the newest version. Nothing is sent and nothing is installed."
msgstr "Raz w tygodniu pyta GitHub o najnowszą wersję. Nic nie jest wysyłane i nic nie jest instalowane."

#: src/ui_settings.py
msgid "Updates"
msgstr "Aktualizacje"

#: src/ui_settings.py
#, python-brace-format
msgid "Installed version: {version}"
msgstr "Zainstalowana wersja: {version}"

#: src/ui_settings.py
msgid "Check now"
msgstr "Sprawdź teraz"

#: src/ui_settings.py
msgid "Could not check for updates. Are you online?"
msgstr "Nie udało się sprawdzić aktualizacji. Czy jesteś online?"

#: src/ui_settings.py
msgid "TrustCopy is up to date."
msgstr "TrustCopy jest aktualny."

#: src/ui_dialogs.py
#, python-brace-format
msgid "TrustCopy {version} is available"
msgstr "Dostępny jest TrustCopy {version}"

#: src/ui_dialogs.py
msgid "Release notes"
msgstr "Informacje o wydaniu"

#: src/ui_settings.py
#, python-brace-format
msgid "Update available: {version}"
msgstr "Dostępna aktualizacja: {version}"

#: src/ui_settings.py
msgid "Other"
msgstr "Inne"

