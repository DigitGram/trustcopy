#: src/ui_dialogs.py
#, python-brace-format
msgid "The computer shuts down in {n} second."
msgid_plural "The computer shuts down in {n} seconds."
msgstr[0] "Komputer wyłączy się za {n} sekundę."
msgstr[1] "Komputer wyłączy się za {n} sekundy."
msgstr[2] "Komputer wyłączy się za {n} sekund."

#: src/ui_dialogs.py
#, python-brace-format
msgid "The computer suspends in {n} second."
msgid_plural "The computer suspends in {n} seconds."
